# --- Supabase (server-only; never expose the service role key to the client) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Manage Team admin gate ---
ADMIN_PASSWORD=change-me

# --- Archive email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
# Verified sender in your Resend account (e.g. updates@yourdomain.com). Use onboarding@resend.dev for testing.
ARCHIVE_EMAIL_FROM=onboarding@resend.dev
ARCHIVE_EMAIL_TO=gaurav.deore@fdplfinance.com

# --- Cron protection (Vercel auto-injects this as a Bearer token for cron calls) ---
CRON_SECRET=some-long-random-string
